# 复制为 .env.development.local 等文件以覆盖本地配置（勿提交含密钥的文件）

# HTTP API 根路径（与 axios baseURL 一致；不要尾随斜杠）
VITE_API_BASE_URL=https://api.aiecnu.net/psych

# WebSocket 完整地址
VITE_WS_URL=wss://api.aiecnu.net/psych/chat

# 请求头 X-Xh-Env，按后端环境调整
VITE_XH_ENV=test

# 鏈湴鐩存帴璁块棶 / 鏃朵娇鐢ㄧ殑榛樿鏈烘瀯 URI
VITE_DEFAULT_UNIT_URI=gmqwgy

# 仅用于本地预览多人物选择 UI，生产环境不要开启
VITE_CHARACTER_SELECTION_MOCK=false

# COS 静态资源 CDN；上传完成后与 objectKey 拼成可直接访问的图片地址
VITE_STATIC_CDN_BASE_URL=https://psych-static.aiecnu.net
